# frozen_string_literal: true

# An application that depends on mini_racer only through another gem (rtlcss),
# using the shim recipe from the README: Bundler must resolve mini_racer to the
# shim and the shim to mini_racer_rs.

source "https://rubygems.org"

gem "mini_racer", path: "../../../shim"
gem "mini_racer_rs", path: "../../.."
gem "rtlcss", "0.2.1"
